# The report writer decides how report wording is produced.
# gemini = AI wording (needs a key); template = offline wording, no key needed.
REPORT_WRITER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash
CATEGORIES_DIR=backend/config/categories

# Checkpoints are configured per category in config/categories/*.json.
# The old single CHECKPOINT_PATH setting is no longer used.

# Leave empty to enable all available categories.
# Example: ENABLED_CATEGORIES=bottle,metal_nut
ENABLED_CATEGORIES=

# Optional overrides (defaults shown)
# GEMINI_API_VERSION=v1beta
# REPORT_TIMEOUT_SECONDS=20
# REPORT_IMAGE_MAX_SIDE=1024
# REPORT_INCLUDE_IMAGE=true
# REPORT_MAX_ATTEMPTS=2
# MAX_TRANSCRIPT_CHARS=1000
# PERSONA_NAME=factory_qc_operator
# DETECTOR_DEVICE=auto
